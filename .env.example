# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE (Web Cloud Sync & Auth - Configure in Vercel Environment Variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Authentication (Offline-first encryption)
# When using local mode (without Supabase auth), the encryption key derived from the user's password.
# This enables offline data storage with AES-GCM encryption in localStorage.
LOCAL_AUTH_ENABLED=true

# PWA (Progressive Web App)
PWA_ENABLED=true
